COMPOSE_PROJECT_NAME=marketplace-samai

# Host ports exposed by Docker.
HOST_WEB_PORT=88
HOST_API_PORT=47301

# Docker Hub image for the frontend nginx/static web image.
WEB_IMAGE=minorsoft/marketplacesamai:latest

# Docker Hub image for the backend Node/Express API image.
API_IMAGE=minorsoft/marketplacesamai-api:latest

# ERP/PostgreSQL database used by MarketPlaceWebServiceExpress.
DB_HOST=demserver.3bbddns.com
DB_PORT=47309
DB_USER=postgres
DB_PASSWORD=sml
DB_NAME=demo
DB_IMAGES_NAME=demo_images
PROVIDER=DEMO

# Runs the safe, allowlisted marketplace schema migrations before the API
# starts listening. Set to 0 only as an emergency operational override.
MARKETPLACE_AUTO_MIGRATE=1

# Content/media settings inside the API container.
MARKETPLACE_SITE_NAME=สมัยการค้า
MARKETPLACE_CONTENT_SCOPE=demo
# Public-facing URL of this deployment (used to build absolute media URLs).
# Set this to the domain that clients use to reach the API, e.g. https://shop.example.com
MARKETPLACE_PUBLIC_URL=
